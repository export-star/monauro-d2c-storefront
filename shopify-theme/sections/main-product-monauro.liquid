{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign hero_video = ''
  assign hero_images = ''
  assign model = product.handle
  assign product_copy = product.description | strip_html

  case product.handle
    when 'recoveryair-calf-pro'
      assign model = 'MC06'
      assign hero_video = 'home-hero-01.mp4'
      assign hero_images = 'mc06-hero-01.webp|mc06-hero-02.webp|mc06-hero-03.webp'
      assign product_copy = 'Rhythmic air compression, 42℃ / 45℃ heated surface support, and a short 15-minute auto-off routine for heavy, tight calves.'
    when 'monauro-recoveryair-leg-elite'
      assign model = 'ML01'
      assign hero_video = 'ml01-product-video.mp4'
      assign hero_images = 'ml01-hero-01.webp|ml01-hero-02.webp|ml01-hero-03.webp|ml01-hero-04.webp|ml01-hero-05.webp|ml01-hero-06.webp|ml01-hero-07.webp|ml01-hero-08.webp|ml01-hero-09.webp|ml01-hero-10.webp|ml01-hero-11.webp|ml01-hero-12.webp|ml01-hero-13.webp|ml01-hero-14.webp|ml01-hero-15.webp'
      assign product_copy = 'EMS massage, heated comfort, and air-bag compression support for broader leg recovery routines.'
    when 'relaxiwave-eye-mask'
      assign model = 'ME01'
      assign hero_video = 'me01-product-video.mp4'
      assign hero_images = 'me01-hero-01.webp|me01-hero-02.webp|me01-hero-03.webp|me01-hero-04.webp|me01-hero-05.webp|me01-hero-06.webp|me01-hero-07.webp'
      assign product_copy = 'A 15-minute soothing routine for tired eyes with vibration massage, heated comfort, and built-in white noise.'
    when 'back-massage-gun'
      assign model = 'MG01'
      assign hero_video = 'mg01-product-video.mp4'
      assign hero_images = 'mg01-hero-01.webp|mg01-hero-02.webp|mg01-hero-03.webp|mg01-hero-04.webp|mg01-hero-05.webp|mg01-hero-06.webp|mg01-hero-07.webp|mg01-hero-08.webp|mg01-hero-09.webp|mg01-hero-10.webp|mg01-hero-11.webp|mg01-hero-12.webp|mg01-hero-13.webp|mg01-hero-14.webp|mg01-hero-15.webp|mg01-hero-16.webp|mg01-hero-17.webp|mg01-hero-18.webp|mg01-hero-19.webp|mg01-hero-20.webp|mg01-hero-21.webp|mg01-hero-22.webp|mg01-hero-23.webp|mg01-hero-24.webp|mg01-hero-25.webp|mg01-hero-26.webp'
      assign product_copy = 'Four speed levels, five massage heads, and an extended form for independent back massage and full-body routines.'
  endcase

  assign hero_image_list = hero_images | split: '|'
  assign slide_count = hero_image_list.size
  if hero_video != blank
    assign slide_count = slide_count | plus: 1
  endif
%}

<section class="product-showcase" data-product-shell>
  <div class="product-showcase__media" data-media-slider>
    {% assign slide_index = 0 %}
    {% if hero_video != blank %}
      <div class="product-showcase__slide is-active" data-slide data-slide-index="{{ slide_index }}">
        <video class="product-showcase__asset" autoplay loop muted playsinline preload="metadata" aria-label="{{ product.title | escape }} product video">
          <source src="{{ hero_video | asset_url }}" type="video/mp4">
        </video>
      </div>
      {% assign slide_index = slide_index | plus: 1 %}
    {% endif %}

    {% for image_name in hero_image_list %}
      <button class="product-showcase__slide{% if hero_video == blank and forloop.first %} is-active{% endif %}" type="button" data-slide data-slide-index="{{ slide_index }}" data-zoom-source="{{ image_name | asset_url }}" aria-label="Open {{ product.title | escape }} image {{ forloop.index }}">
        <img class="product-showcase__asset product-showcase__asset--contain" src="{{ image_name | asset_url }}" alt="{{ product.title | escape }} product view {{ forloop.index }}" width="1800" height="1800" {% unless forloop.first and hero_video == blank %}loading="lazy"{% endunless %}>
      </button>
      {% assign slide_index = slide_index | plus: 1 %}
    {% endfor %}

    {% if slide_count > 1 %}
      <div class="product-showcase__controls" aria-label="Product media controls">
        <button class="icon-button" type="button" data-slide-prev aria-label="Previous media">‹</button>
        <span class="product-showcase__counter"><span data-slide-current>1</span><span aria-hidden="true">/</span><span>{{ slide_count }}</span></span>
        <button class="icon-button" type="button" data-slide-next aria-label="Next media">›</button>
      </div>
    {% endif %}
  </div>

  <div class="product-purchase">
    <div class="product-purchase__intro">
      <p class="eyebrow">{{ product.title }} / {{ model }}</p>
      <h1>{{ product.title }}</h1>
      <p>{{ product_copy }}</p>
    </div>

    {% form 'product', product, data-product-form: '' %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
      <div class="product-purchase__form">
        <div class="product-purchase__price-row">
          <p class="product-price" data-price>{{ current_variant.price | money }}</p>
          <p class="product-purchase__policy">30-day risk-free trial · 365-day warranty</p>
        </div>

        {% if product.variants.size > 1 %}
          <fieldset class="variant-swatches">
            <legend>Color <span data-variant-label>{{ current_variant.title }}</span></legend>
            <div class="variant-swatches__items">
              {% for variant in product.variants %}
                {% liquid
                  assign color_value = variant.option1
                  assign color_hex = '#d9d9d4'
                  case color_value
                    when 'Calm Purple'
                      assign color_hex = '#B9A3E3'
                    when 'Vivid Orange'
                      assign color_hex = '#FF8039'
                    when 'Pale Green'
                      assign color_hex = '#2CD5C4'
                    when 'Electric Green'
                      assign color_hex = '#B9E972'
                  endcase
                %}
                <button class="variant-swatch{% if variant == current_variant %} is-active{% endif %}" type="button" style="--swatch-color: {{ color_hex }};" data-variant-button data-variant-id="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}" data-variant-price="{{ variant.price | money | escape }}" data-variant-available="{{ variant.available }}" aria-label="{{ variant.title | escape }}{% unless variant.available %}, sold out{% endunless %}" aria-pressed="{% if variant == current_variant %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}></button>
              {% endfor %}
            </div>
          </fieldset>
        {% endif %}

        <div class="product-purchase__actions">
          <label class="quantity-stepper"><span>Quantity</span><input type="number" name="quantity" min="1" value="1" inputmode="numeric"></label>
          <button class="btn btn-primary product-purchase__add" type="submit" name="add" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
          <div class="product-purchase__buy-now">{{ form | payment_button }}</div>
        </div>
      </div>
    {% endform %}
  </div>

  <dialog class="product-zoom" data-product-zoom>
    <button class="icon-button product-zoom__close" type="button" data-product-zoom-close aria-label="Close image">×</button>
    <img data-product-zoom-image alt="{{ product.title | escape }} enlarged product view" width="2200" height="2200">
  </dialog>
</section>

{% schema %}
{
  "name": "MONAURO product hero",
  "settings": []
}
{% endschema %}