<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f7f4">
    <title>{{ page_title }}{% if current_tags %} - {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} - {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% if template.name == 'index' %}
      {{ 'home-calf-pro.png' | asset_url | preload_tag: as: 'image' }}
    {% endif %}
    {{ content_for_header }}
    {{ 'monauro-theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template.name | handle }}">
    {% section 'monauro-header' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'monauro-footer' %}
    <script src="{{ 'monauro-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
