# MONAURO Shopify draft connection
# Copy this file to .env.local and fill values locally. Do not commit real tokens.

# Example: monauro.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API public access token from Shopify Admin. Use this for normal headless storefront testing.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional private token. If filled, server requests use Shopify-Storefront-Private-Token instead of the public header.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Keep the API version explicit for repeatable testing.
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Default safety mode: false means product/variant matching only, no cart is created.
SHOPIFY_CREATE_CARTS=false

# Keep false during draft testing. Only true when you intentionally want Buy Now to redirect to Shopify Checkout.
SHOPIFY_ENABLE_CHECKOUT_REDIRECT=false

