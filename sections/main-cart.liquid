<main class="cart-page">
  <section class="cart-intro">
    <div class="page-shell">
      <p class="shop-badge">Your recovery routine</p>
      <h1>Your cart</h1>
      <p>Review your selected device, color, and quantity before moving to Shopify's secure checkout.</p>
    </div>
  </section>

  <section class="cart-content">
    <div class="page-shell">
      {% if cart.item_count > 0 %}
        {% form 'cart', cart, class: 'cart-form', id: 'cart' %}
          <div class="cart-layout">
            <div class="cart-lines">
              {% for item in cart.items %}
                <article class="cart-line">
                  <a href="{{ item.url }}" class="cart-line-media">
                    {% if item.image %}
                      {{ item.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: item.product.title }}
                    {% endif %}
                  </a>
                  <div class="cart-line__content">
                    <p class="product-kicker">{{ item.product.type | default: 'MONAURO device' }}</p>
                    <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                    {% unless item.product.has_only_default_variant %}<p class="cart-line__variant">{{ item.variant.title }}</p>{% endunless %}
                    {% if item.selling_plan_allocation %}<p class="cart-line__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>{% endif %}
                    <div class="cart-line__meta">
                      <label><span>Quantity</span><input class="quantity-input" type="number" name="updates[]" min="0" value="{{ item.quantity }}" inputmode="numeric" aria-label="Quantity for {{ item.product.title | escape }}"></label>
                      <a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                  <div class="cart-line__price">
                    {% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}
                    <strong>{{ item.final_line_price | money }}</strong>
                  </div>
                </article>
              {% endfor %}
            </div>

            <aside class="cart-summary">
              <p class="product-kicker">Order summary</p>
              <div class="cart-summary__subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
              <p class="cart-summary__shipping">Shipping and taxes are calculated at checkout. Free shipping applies to orders over $99.</p>
              <label class="cart-note"><span>Order note</span><textarea name="note" rows="3" placeholder="Optional">{{ cart.note }}</textarea></label>
              <div class="cart-summary__secondary-actions">
                <input class="btn btn-outline cart-update" type="submit" name="update" value="Update quantities">
                <button class="btn btn-outline cart-clear" type="submit" formaction="{{ routes.cart_clear_url }}" formmethod="post" formnovalidate>Clear cart</button>
              </div>
              <input class="btn btn-primary cart-checkout" type="submit" name="checkout" value="Secure checkout">
              <div class="cart-trust">
                <p><strong>30-day risk-free trial</strong><span>Returns and exchanges</span></p>
                <p><strong>365-day warranty</strong><span>Product warranty</span></p>
              </div>
            </aside>
          </div>
        {% endform %}
        <a class="cart-continue" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
      {% else %}
        <div class="empty-state cart-empty">
          <p class="product-kicker">Nothing selected yet</p>
          <h2>Your cart is empty.</h2>
          <p>Start with the device that matches the body area and routine you want to support.</p>
          <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Shop all devices</a>
        </div>
      {% endif %}
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}