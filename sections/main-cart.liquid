<section class="section cart-section">
  <div class="section-header"><h1>Your cart</h1><p>Review your MONAURO routine before checkout.</p></div>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart-lines">
        {% for item in cart.items %}
          <article class="cart-line">
            <a href="{{ item.url }}" class="cart-line-media">{% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a>
            <div><h2>{{ item.product.title }}</h2><p>{{ item.variant.title }}</p><p>{{ item.final_line_price | money }}</p></div>
            <input class="quantity-input" type="number" name="updates[]" min="0" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title }}">
          </article>
        {% endfor %}
      </div>
      <div class="cart-summary">
        <p>Subtotal <strong>{{ cart.total_price | money }}</strong></p>
        <button class="btn btn-outline" type="submit" name="update">Update cart</button>
        <button class="btn btn-primary" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% else %}
    <div class="empty-state"><h2>Your cart is empty.</h2><p>Start with the device that matches your routine.</p><a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">Shop products</a></div>
  {% endif %}
</section>
{% schema %}
{ "name": "Main cart" }
{% endschema %}
